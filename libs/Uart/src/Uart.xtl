# Uart: a serial port (UART: 8 data bits, no parity, 1 stop bit) as X_eTaL step functions: a transmitter, a receiver, and the two looped back
# Import it with an alias of your choice: "ua:" u_se< "Uart".
# Put libs/Uart/src on XETAL_PATH ("just path"); the reference is libs/Uart/docs.
# Names with l: are exported; the others are private to this file.
#
# A line idles at 1. A byte is sent as a frame of ten bits, each held
# for d clocks: a start bit (0), the eight data bits, least significant
# first, and a stop bit (1). d, the clocks per bit, is the clock rate
# over the baud rate: 234 for a 27 MHz Tang Nano at 115200 baud, 3 in
# the tests. It is the first argument of every step, bound once:
# u:t_x := ua:t_x 3, then s0 'u:t_x ck:r_un commands (Clocked's harness).
# Each step is pure, one clock's input in, the next state out.

### The transmitter

# Its state, four registers: busy (0 or 1), clocks left in this bit,
# bits left in the frame, the frame (bit 0 on the line).
l:TxIdle := 0 0 0 0

# d t_x s c: the transmitter after one clock. A command c of 0 to 255
# starts sending that byte when it is idle; -1 is no command (a
# command while busy is ignored).
l:t_x := { d s c ->
  b := f_irst s
  n := 2 s_elect s
  k := 3 s_elect s
  f := 4 s_elect s
  (b = 0) & c >= 0 ? 1 c_at (d - 1) c_at 10 c_at 512 + 2 * c m_od 256
  b = 0 ? 0 0 0 0
  n > 0 ? 1 c_at (n - 1) c_at k c_at f
  k = 1 ? 0 0 0 0
  1 c_at (d - 1) c_at (k - 1) c_at f d_iv 2
}

# l_ine s: the transmitter's line: 1 when idle, else the frame's bit 0.
l:l_ine := { s -> (1 - f_irst s) + (f_irst s) * (4 s_elect s) m_od 2 }

### The receiver

# Its state, six registers: phase (0 idle, 1 receiving, 2 waiting for
# the stop bit), clocks to the next sample, bits left, the bits so
# far, the last byte received, and valid (1 for the one clock after a
# byte arrives).
l:RxIdle := 0 0 0 0 0 0

# d r_x s l: the receiver after one clock of the line l. A fall to 0
# while idle is a start bit; each data bit is sampled in its middle
# (d + d/2 clocks after the fall, then every d clocks), least
# significant first.
l:r_x := { d s l ->
  p := f_irst s
  n := 2 s_elect s
  k := 3 s_elect s
  sh := 4 s_elect s
  da := 5 s_elect s
  (p = 0) & l = 0 ? 1 c_at (d + (d d_iv 2) - 1) c_at 8 c_at 0 c_at da c_at 0
  p = 0 ? 0 0 0 0 c_at da c_at 0
  p = 2 ? (2 * 1 - l) c_at 0 0 0 c_at da c_at 0
  n > 0 ? 1 c_at (n - 1) c_at k c_at sh c_at da c_at 0
  s2 := (sh d_iv 2) + 128 * l
  k = 1 ? 2 0 0 0 c_at s2 c_at 1
  1 c_at (d - 1) c_at (k - 1) c_at s2 c_at da c_at 0
}

# r_eceived s: the last byte received; v_alid? s: whether it arrived
# on the last clock.
l:r_eceived := { s -> 5 s_elect s }
l:v_alid? := { s -> 1 = 6 s_elect s }

### Looped back

# The transmitter's line wired to the receiver, and a log of the first
# four bytes received with their count: fifteen registers, the
# transmitter's four, the receiver's six, the log's four, the count.
l:LoopIdle := 15 r_eshape 0

# d l_oopback s c: one clock: the receiver samples the line as the
# transmitter drives it now, then both step, and a byte that arrives
# goes into the log at the count.
l:l_oopback := { d s c ->
  tx := 4 t_ake s
  rx := 6 t_ake 4 d_rop s
  lg := 4 t_ake 10 d_rop s
  ct := 15 s_elect s
  rx2 := (d l:r_x rx)_ l:l_ine tx
  v := 6 s_elect rx2
  lg2 := lg + v * ((o_ffsets 4) = ct) * (5 s_elect rx2) - lg
  ((d l:t_x tx)_ c) c_at rx2 c_at lg2 c_at ct + v
}

# l_ines t: the transmitter's line for every row of a trace (of the
# transmitter, or of the looped-back pair: both start with its four
# registers).
l:l_ines := { t ->
  b := 1 s_elect_2 t
  (1 - b) + b * (4 s_elect_2 t) m_od 2
}

# l_og s: the bytes received so far, from a looped-back state.
l:l_og := { s -> (4 m_in 15 s_elect s) t_ake 4 t_ake 10 d_rop s }

# The commands that send bytes (0 to 255), each when the transmitter
# is free: d c_ommands bytes gives one command per clock, the byte at
# the start of each frame of 10 d + 1 clocks, -1 elsewhere, with d
# more clocks at the end for the last stop bit.
l:c_ommands := { d bytes ->
  per := 1 + 10 * d
  at := per * o_ffsets t_ally bytes
  all := ((per * t_ally bytes) + d) r_eshape -1
  all + ((o_ffsets t_ally all) '= t_able at) '+ '* i_nner bytes + 1
}
