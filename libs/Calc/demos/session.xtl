#!/usr/bin/env xetal
# A session at the calculator: each line a key sequence and what the
# display shows at the end. The chip's registers are 16-bit, so the
# last two wrap. Run with "just demo-lib Calc session".
"calc:" u_se< "Calc"
calc:c_alc "2+3="
calc:c_alc "12+34="
calc:c_alc "7*8="
calc:c_alc "123-27="
calc:c_alc "100/7="
calc:c_alc "1+2+3+4="
calc:c_alc "5-7="
calc:c_alc "60000+10000="
calc:c_alc "300*300="
