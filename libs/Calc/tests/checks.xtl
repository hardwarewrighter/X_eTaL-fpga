#!/usr/bin/env xetal
# Calc: calculations against their answers, with the Check library;
# "ok" per check. Run with "just run-lib Calc checks".
"calc:" u_se< "Calc"
"fx:" u_se< "Fixed"
"k:" u_se< "Check"
k:r_eport (
  ("2 + 3 = 5" k:t_est 5 k:i_s calc:c_alc "2+3=")
  k:a_nd ("12 + 34 = 46" k:t_est 46 k:i_s calc:c_alc "12 + 34 =")
  k:a_nd ("7 * 8 = 56" k:t_est 56 k:i_s calc:c_alc "7*8=")
  k:a_nd ("123 - 27 = 96" k:t_est 96 k:i_s calc:c_alc "123-27=")
  k:a_nd ("100 / 7 = 14 (whole numbers)" k:t_est 14 k:i_s calc:c_alc "100/7=")
  k:a_nd ("1 / 0 = 0 (no trap)" k:t_est 0 k:i_s calc:c_alc "1/0=")
  k:a_nd ("chained: 1 + 2 + 3 = 6" k:t_est 6 k:i_s calc:c_alc "1+2+3=")
  k:a_nd ("left to right: 2 * 3 + 4 = 10" k:t_est 10 k:i_s calc:c_alc "2*3+4=")
  k:a_nd ("negative: 5 - 7 = -2" k:t_est -2 k:i_s calc:c_alc "5-7=")
  k:a_nd ("16-bit wrap: 60000 + 10000 = 4464" k:t_est (16 fx:w_rap 70000) k:i_s calc:c_alc "60000+10000=")
  k:a_nd ("16-bit wrap: 300 * 300" k:t_est (16 fx:w_rap 90000) k:i_s calc:c_alc "300*300=")
  k:a_nd ("the result continues: 12 + 34 = + 1 = is 47" k:t_est 47 k:i_s calc:c_alc "12+34=+1=")
  k:a_nd ("a digit after = starts over" k:t_est 6 k:i_s calc:c_alc "12+34=5+1=")
  k:a_nd ("clear" k:t_est 34 k:i_s calc:c_alc "12+C34=")
  k:a_nd ("= with no operation shows the entry" k:t_est 12 k:i_s calc:c_alc "12=")
  k:a_nd ("an operator first uses 0" k:t_est 5 k:i_s calc:c_alc "+5=")
  k:a_nd ("a second operator replaces the first" k:t_est 8 k:i_s calc:c_alc "2+*4=")
  k:a_nd ("the display shows the entry while keying" k:t_est 123 k:i_s calc:d_isplay calc:Reset calc:r_un calc:k_eys "123")
  k:a_nd ("the display shows the result at an operator" k:t_est 46 k:i_s calc:d_isplay calc:Reset calc:r_un calc:k_eys "12+34+")
  k:a_nd ("unknown keys are ignored" k:t_est 46 k:i_s calc:c_alc "12 + 34 = x")
  k:a_nd ("r_un is s_tep folded" k:t_est (calc:Reset calc:r_un 1 2) k:i_s (calc:Reset calc:s_tep 1) calc:s_tep 2)
  k:a_nd ("t_race has a row per key plus the start" k:t_est 7 5 k:i_s s_hape calc:Reset calc:t_race calc:k_eys "12+34=")
)
