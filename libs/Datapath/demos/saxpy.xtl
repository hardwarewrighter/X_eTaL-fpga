#!/usr/bin/env xetal
# y := a x + y on eight 16-bit numbers: a multiplier and an adder per
# element, every unit 16 bits. Run with "just demo-lib Datapath saxpy".
"dp:" u_se< "Datapath"
x := 1 2 3 4 5 6 7 8
y := 100 200 300 400 500 600 700 800
u:s_axpy := 16 dp:s_axpy 3
x u:s_axpy y
u:b_ig := 16 dp:s_axpy 10000
x u:b_ig y                    # the products wrap past 32767
