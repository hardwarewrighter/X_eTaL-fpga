#!/usr/bin/env xetal
# '+ r_/ v as a tree of adders: eight 16-bit numbers, three levels,
# seven adders. Wrapping at every adder gives the bits the wrapped
# exact sum has. Run with "just demo-lib Datapath reduce-sum".
"dp:" u_se< "Datapath"
v := 1 2 3 4 5 6 7 8
'+ r_/ v                      # the evaluator
16 dp:s_um v                  # the tree
big := 8 r_eshape 10000       # 80000 does not fit in 16 bits
'+ r_/ big
16 dp:s_um big                # the tree's answer: 80000 wrapped
dp:l_argest v                 # a tree of comparators
