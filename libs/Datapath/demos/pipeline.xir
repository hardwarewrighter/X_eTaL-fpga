# pipeline.xtl hand-lowered: multiply, add, select, reduce, on eight
# 16-bit numbers: the sum of the positive items of x + x * k.
# baseline: demo-pipeline 1-3
%x = input i16[8] 1 2 3 4 5 6 7 8
%k = input i16[8] 1 -1 1 -1 1 -1 1 -1
%zero = const i16 0
%xk = map mul %x %k
%s = map add %x %xk
%r = map max %s %zero
%sum = reduce add %r
output %s %r %sum
