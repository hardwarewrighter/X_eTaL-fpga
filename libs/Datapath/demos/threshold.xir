# threshold.xtl hand-lowered: the mask x > 4 (a comparator per
# element) as the select line of a mux per element; relu is the same
# with 0 (a max).
# baseline: demo-threshold 1-4
%x = input i16[8] 5 -3 12 0 7 -8 20 1
%t = const i16 4
%zero = const i16 0
%m = map gt %x %t
%kept = select %m %x %zero
%relu = map max %x %zero
output %m %kept %kept %relu
