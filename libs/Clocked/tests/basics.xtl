5 ck:t_ick 1
127 ck:t_ick 1
5 ck:t_ick 0
100 ck:a_ccumulate 100
(0 0 0 1) ck:s_hift 1
0 ck:d_etect 1
1 ck:d_etect 0
2 ck:d_etect 1
3 ck:d_etect 0
ck:f_ound? 3
(4 r_eshape 0) ck:w_rite 1 2 9
(0 0 9 0) ck:r_ead 2
0 'ck:a_ccumulate ck:r_un 1 2 3 4
0 'ck:a_ccumulate ck:t_race 1 2 3 4
(0 0 0) 'ck:s_hift ck:t_race 1 1 0
